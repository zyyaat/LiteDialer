<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/phone_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/addContact"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_contact"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_gear"
            app:tint="@color/text_primary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/defaultBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_banner"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/set_default"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:visibility="gone"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/keypad"
            layout="@layout/view_keypad"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/callLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contactsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/firstRun"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@color/bg"
            android:visibility="gone">

            <TextView
                android:id="@+id/firstRunTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/first_run_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/firstRunBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/first_run_body"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/grantPermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/grant_permissions"/>

            <Button
                android:id="@+id/setDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/set_default"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/tabKeypad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabKeypadText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_keypad"
                android:textSize="14sp"
                android:textColor="@color/accent"/>

            <View
                android:id="@+id/underlineKeypad"
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_underline"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRecents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabRecentsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_recents"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <View
                android:id="@+id/underlineRecents"
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_underline"
                android:visibility="invisible"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabContactsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_contacts"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <View
                android:id="@+id/underlineContacts"
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_underline"
                android:visibility="invisible"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
